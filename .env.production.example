# Production settings for docker-compose.prod.yml.
# Copy to .env.production, replace EVERY value, keep the file out of Git.
# Generate secrets with: openssl rand -base64 32

# Public host name; Caddy obtains a TLS certificate for it automatically.
DOMAIN=cms.example.com

# Database superuser (used only for initialization, backups and restores).
POSTGRES_PASSWORD=change-me-superuser-password
# Application role (row-level security applies to it).
APP_DB_PASSWORD=change-me-app-password

# Required header value for the one-time first-run setup (x-setup-token).
SETUP_TOKEN=change-me-at-least-16-characters

# single: one organization; multi: many isolated tenants (platform admins provision them)
TENANCY_MODE=single

# Keep true behind HTTPS. Set to false only for local evaluation over plain http.
COOKIE_SECURE=true

LOG_LEVEL=info

# Media storage: local (Docker volume) or s3 (S3, R2, MinIO, ...)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional tenant quotas (0 = unlimited)
TENANT_MAX_RECORDS=0
TENANT_MAX_MEDIA_BYTES=0
