# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Application database role (not a superuser; row-level security applies).
# `pnpm --filter @bytecontent/api db:setup-local` creates these locally.
DATABASE_URL=postgresql://byterings:byterings@localhost:5432/byterings_dev

# single: one organization per installation; multi: many isolated tenants
TENANCY_MODE=single

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
