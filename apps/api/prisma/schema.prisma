// Platform system schema. Metadata-managed record values live in JSONB
// (ADR-004). Tenant-owned tables are protected by row-level security
// policies defined in the SQL migrations (see migrations/*/migration.sql):
// rows are visible only when `app.tenant_id` matches, or when a vetted
// system code path sets `app.bypass_rls = on`.
//
// Creating migrations: see apps/api/scripts/new-migration.mjs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
}

enum UserStatus {
  active
  disabled
}

enum MembershipRole {
  owner
  admin
  editor
  viewer
}

/// Singleton row describing this installation (id is always 1).
model Installation {
  id              Int      @id @default(1)
  defaultTenantId String?  @map("default_tenant_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("installation")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  apiKeys     ApiKey[]
  entities    Entity[]

  @@map("tenants")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased.
  email           String     @unique
  name            String
  passwordHash    String     @map("password_hash")
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  status          UserStatus @default(active)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

/// Tenant-owned (RLS).
model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Browser sessions (ADR-013). Only the SHA-256 hash of the token is stored.
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  userId         String   @map("user_id") @db.Uuid
  activeTenantId String?  @map("active_tenant_id") @db.Uuid
  csrfToken      String   @map("csrf_token")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Tenant-bound API keys for machine clients (ADR-013). Tenant-owned (RLS).
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  /// Non-secret identifier shown in listings, e.g. "bcms_ab12cd34".
  prefix      String
  keyHash     String    @unique @map("key_hash")
  scopes      String[]
  createdById String?   @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

enum EntityStatus {
  active
  archived
}

/// Entity definition (metadata). Tenant-owned (RLS). Key is immutable.
model Entity {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  key          String
  name         String
  pluralName   String       @map("plural_name")
  description  String?
  titleField   String?      @map("title_field")
  publicRead   Boolean      @default(false) @map("public_read")
  publishField String?      @map("publish_field")
  publishValue String?      @map("publish_value")
  status       EntityStatus @default(active)
  /// tenant | template:<id> | plugin:<id> (ADR-026)
  owner        String       @default("tenant")
  overridden   Boolean      @default(false)
  checksum     String?
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields  Field[]
  records Record[]

  @@unique([tenantId, key])
  @@unique([id, tenantId])
  @@map("entities")
}

/// Field definition. Tenant-owned (RLS). The composite foreign key guarantees
/// a field always belongs to an entity of the same tenant.
model Field {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  entityId     String         @map("entity_id") @db.Uuid
  key          String
  label        String
  type         String
  description  String?
  required     Boolean        @default(false)
  unique       Boolean        @default(false)
  isPublic     Boolean        @default(false) @map("is_public")
  readMinRole  MembershipRole @default(viewer) @map("read_min_role")
  writeMinRole MembershipRole @default(editor) @map("write_min_role")
  defaultValue Json?          @map("default_value")
  config       Json           @default("{}")
  position     Int            @default(0)
  owner        String         @default("tenant")
  overridden   Boolean        @default(false)
  checksum     String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  entity       Entity              @relation(fields: [entityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  uniqueValues RecordUniqueValue[]
  links        RecordLink[]

  @@unique([entityId, key])
  @@index([tenantId])
  @@map("fields")
}

/// Metadata-managed record (ADR-004). Values live in `data` (JSONB), keyed by
/// field key; null values are not stored. Tenant-owned (RLS). Soft-deletable
/// (ADR-015) with optimistic concurrency via `version` (ADR-019).
model Record {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  entityId    String    @map("entity_id") @db.Uuid
  data        Json      @default("{}")
  version     Int       @default(1)
  createdById String?   @map("created_by")
  updatedById String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  entity       Entity              @relation(fields: [entityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  uniqueValues RecordUniqueValue[]
  linksOut     RecordLink[]        @relation("LinkSource")
  linksIn      RecordLink[]        @relation("LinkTarget")

  @@unique([id, tenantId])
  @@index([tenantId, entityId, deletedAt, createdAt])
  @@map("records")
}

/// Enforces unique field values across a tenant's live records (ADR-021).
model RecordUniqueValue {
  tenantId String @map("tenant_id") @db.Uuid
  fieldId  String @map("field_id") @db.Uuid
  value    String
  recordId String @map("record_id") @db.Uuid

  record Record @relation(fields: [recordId, tenantId], references: [id, tenantId], onDelete: Cascade)
  field  Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([fieldId, value])
  @@index([recordId])
  @@map("record_unique_values")
}

/// Relation links between records (ADR-022). The record JSONB mirrors the
/// target id(s) for simple reads; this table provides integrity and reverse
/// lookups. Composite keys keep both ends inside one tenant. Tenant-owned (RLS).
model RecordLink {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  fieldId        String @map("field_id") @db.Uuid
  sourceRecordId String @map("source_record_id") @db.Uuid
  targetRecordId String @map("target_record_id") @db.Uuid
  position       Int    @default(0)

  field  Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  source Record @relation("LinkSource", fields: [sourceRecordId, tenantId], references: [id, tenantId], onDelete: Cascade)
  target Record @relation("LinkTarget", fields: [targetRecordId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([fieldId, sourceRecordId, targetRecordId])
  @@index([targetRecordId])
  @@index([tenantId])
  @@map("record_links")
}

/// Uploaded file metadata (ADR-023). The bytes live in the storage driver
/// under a tenant-prefixed key. Tenant-owned (RLS). Soft-deletable.
model Media {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  storageKey  String    @unique @map("storage_key")
  filename    String
  mimeType    String    @map("mime_type")
  kind        String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  checksum    String
  createdById String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])
  @@index([tenantId, deletedAt, createdAt])
  @@map("media")
}

/// Templates installed on a tenant (ADR-009, ADR-026). Tenant-owned (RLS).
model TemplateInstallation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  templateId  String   @map("template_id")
  version     String
  installedAt DateTime @default(now()) @map("installed_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, templateId])
  @@map("template_installations")
}

/// Snapshot of an entity definition after each change (ADR-020). Tenant-owned (RLS).
model MetadataVersion {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  entityId  String   @map("entity_id") @db.Uuid
  version   Int
  action    String
  snapshot  Json
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, entityId, version])
  @@map("metadata_versions")
}

/// Audit trail (ADR-024). Stores changed keys, never values. Tenant-owned (RLS);
/// tenant_id is null for installation-level events.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  changedKeys String[] @map("changed_keys")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_events")
}
