{
  "name": "@byteringscms/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:setup-local": "node scripts/setup-local-db.mjs",
    "db:new-migration": "node scripts/new-migration.mjs",
    "cli:setup": "node dist/cli/setup.js"
  },
  "dependencies": {
    "@byteringscms/contracts": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@swc/cli": "^0.7",
    "@swc/core": "^1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/supertest": "^6",
    "prisma": "^6.19.3",
    "supertest": "^7",
    "unplugin-swc": "^1",
    "vitest": "^3"
  }
}
