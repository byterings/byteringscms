{
  "name": "@bytecontent/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:setup-local": "node scripts/setup-local-db.mjs",
    "db:new-migration": "node scripts/new-migration.mjs",
    "cli:setup": "node dist/cli/setup.js",
    "cli:maintenance": "node dist/cli/maintenance.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@bytecontent/contracts": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "multer": "^2.5.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "swagger-ui-dist": "^5.35.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@bytecontent/cli": "workspace:*",
    "@bytecontent/sdk": "workspace:*",
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@swc/cli": "^0.7",
    "@swc/core": "^1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24",
    "@types/supertest": "^6",
    "@types/swagger-ui-dist": "^3.30.6",
    "pino-pretty": "^13.2.0",
    "supertest": "^7",
    "unplugin-swc": "^1",
    "vitest": "^3"
  },
  "files": [
    "dist",
    "prisma",
    "scripts"
  ]
}
