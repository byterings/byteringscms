{
  "name": "bytecontent",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup-local": "pnpm --filter @bytecontent/api db:setup-local",
    "db:deploy": "pnpm --filter @bytecontent/api db:deploy",
    "db:migrate": "pnpm --filter @bytecontent/api db:migrate",
    "db:status": "pnpm --filter @bytecontent/api db:status",
    "test:e2e": "turbo run build && pnpm --filter @bytecontent/admin test:e2e",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "maintenance": "pnpm --filter @bytecontent/api cli:maintenance"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8"
  }
}
